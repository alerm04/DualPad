<UserControl x:Class="DualPad.App.Pages.MappingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DualPad.App.Services"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:DualPad.App.Controls">
    <Grid Margin="28,4,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="{l:T nav.mapping}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="{l:T mapping.subtitle}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- Controller and overview -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Panel}" Padding="18,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <ui:ToggleSwitch x:Name="DetectSwitch" DockPanel.Dock="Left" IsChecked="True"
                                             Content="{l:T mapping.detect}" />
                            <ui:Button DockPanel.Dock="Right" HorizontalAlignment="Right" Icon="{ui:SymbolIcon ArrowReset24}"
                                       Content="{l:T mapping.resetAll}" Click="OnResetAll" />
                        </DockPanel>
                        <c:ControllerView x:Name="Controller" Grid.Row="1" Margin="0,10,0,0" IsInteractive="True" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,12,0,0" Padding="14,12">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{l:T mapping.summary}" />
                        <WrapPanel x:Name="Overview" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Editor -->
            <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="16,0,0,0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="20,20,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="26" Background="#2C3037">
                            <TextBlock x:Name="SelectedGlyph" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="22" FontWeight="Bold" Foreground="White" Text="✕" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="SelectedName" FontSize="18" FontWeight="SemiBold" Text="{l:T ds.cross}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource Caption}" FontSize="13" Text="{l:T mapping.now}" />
                                <TextBlock x:Name="SelectedAction" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}" Text="Xbox · A" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Segmented action type selector -->
                    <Border Grid.Row="1" Margin="20,18,20,0" Padding="3" CornerRadius="9"
                            Background="{DynamicResource ControlAltFillColorSecondaryBrush}">
                        <UniformGrid Rows="1">
                            <RadioButton x:Name="TabXbox" Style="{StaticResource SegmentTab}" GroupName="Kind" Content="{l:T mapping.tab.xbox}" Checked="OnKindTab" />
                            <RadioButton x:Name="TabKeyboard" Style="{StaticResource SegmentTab}" GroupName="Kind" Content="{l:T mapping.tab.keyboard}" Checked="OnKindTab" />
                            <RadioButton x:Name="TabMouse" Style="{StaticResource SegmentTab}" GroupName="Kind" Content="{l:T mapping.tab.mouse}" Checked="OnKindTab" />
                            <RadioButton x:Name="TabNone" Style="{StaticResource SegmentTab}" GroupName="Kind" Content="{l:T mapping.tab.none}" Checked="OnKindTab" />
                        </UniformGrid>
                    </Border>

                    <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,0,20,12">
                            <StackPanel x:Name="XboxPanel" />

                            <StackPanel x:Name="KeyboardPanel" Visibility="Collapsed">
                                <Border x:Name="KeyCapture" Focusable="True" Cursor="Hand" Height="72" CornerRadius="10"
                                        BorderThickness="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        MouseLeftButtonUp="OnKeyCaptureClick" PreviewKeyDown="OnKeyCaptured"
                                        GotKeyboardFocus="OnKeyCaptureFocus" LostKeyboardFocus="OnKeyCaptureBlur">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="KeyCaptureText" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{l:T mapping.key.prompt}" />
                                        <TextBlock x:Name="KeyCaptureHint" HorizontalAlignment="Center" Style="{StaticResource Caption}" Text="{l:T mapping.key.hint}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T mapping.commonKeys}" />
                                <WrapPanel x:Name="CommonKeys" />
                            </StackPanel>

                            <StackPanel x:Name="MousePanel" Visibility="Collapsed">
                                <WrapPanel x:Name="MouseChoices" />
                            </StackPanel>

                            <StackPanel x:Name="NonePanel" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T mapping.none.text}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="3" Padding="20,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                        <DockPanel>
                            <TextBlock x:Name="DefaultHint" DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource Caption}" Text="Predefinito: A" />
                            <ui:Button HorizontalAlignment="Right" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowCounterclockwise24}"
                                       Content="{l:T mapping.reset}" Click="OnResetButton" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
