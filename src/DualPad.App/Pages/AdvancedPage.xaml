<UserControl x:Class="DualPad.App.Pages.AdvancedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,4,28,28" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="Avanzate" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Spegnimento del controller, prestazioni e misura della latenza." />

            <!-- Latency test -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Test di latenza" />
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Quanto ritardo aggiunge DualPad?" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}"
                                       Text="Durante il test (10 secondi) muovi gli stick e premi i tasti. DualPad misura ogni quanto arrivano i dati dal controller, quanto impiega a elaborarli e quanto ci mette il controller Xbox virtuale a renderli leggibili ai giochi (tramite XInput, la stessa via usata dai giochi)." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                            <ui:Button x:Name="StartTest" Appearance="Primary" Icon="{ui:SymbolIcon Play24}" Content="Avvia test" MinWidth="150" Click="OnStartTest" />
                            <TextBlock x:Name="LiveRate" Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar x:Name="TestProgress" Margin="0,14,0,0" Height="6" Maximum="1" Visibility="Collapsed" />
                    <TextBlock x:Name="TestHint" Margin="0,8,0,0" Style="{StaticResource Caption}" FontSize="13" Visibility="Collapsed"
                               Text="Muovi gli stick e premi i tasti…" />

                    <UniformGrid x:Name="Tiles" Columns="4" Margin="0,16,0,0" Visibility="Collapsed">
                        <Border Style="{StaticResource Panel}" Margin="0,0,8,0" Padding="14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="Frequenza dati" />
                                <TextBlock x:Name="RateValue" Style="{StaticResource TileValue}" />
                                <TextBlock x:Name="RateDetail" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Panel}" Margin="4,0,4,0" Padding="14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="Regolarità (99% dei report)" />
                                <TextBlock x:Name="JitterValue" Style="{StaticResource TileValue}" />
                                <TextBlock x:Name="JitterDetail" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Panel}" Margin="4,0,4,0" Padding="14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="Elaborazione DualPad" />
                                <TextBlock x:Name="ProcessingValue" Style="{StaticResource TileValue}" />
                                <TextBlock x:Name="ProcessingDetail" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Panel}" Margin="8,0,0,0" Padding="14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="Consegna al gioco" />
                                <TextBlock x:Name="DeliveryValue" Style="{StaticResource TileValue}" />
                                <TextBlock x:Name="DeliveryDetail" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <ui:InfoBar x:Name="Verdict" Margin="0,12,0,0" IsClosable="False" IsOpen="False" />
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource Caption}"
                               Text="Non misurabile via software: il tempo del collegamento radio Bluetooth e quello del gioco stesso. Per la latenza più bassa possibile usa il cavo USB-C." />
                </StackPanel>
            </Border>

            <!-- Performance -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Prestazioni" />
            <ui:CardControl Icon="{ui:SymbolIcon Flash24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontSize="14" Text="Priorità alta" />
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="Windows dà precedenza a DualPad: l'input resta puntuale anche quando il gioco usa tutta la CPU." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="HighPriority" Click="OnHighPriority" />
            </ui:CardControl>
            <Border Style="{StaticResource Panel}" Margin="0,6,0,0" Padding="16,12">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Già attivo in DualPad" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}"
                               Text="• Thread di lettura dedicato a priorità massima: ogni report viene mappato e inviato subito, senza timer né code." />
                    <TextBlock Style="{StaticResource Caption}" Text="• Coda del driver ridotta al minimo: non vengono mai letti report vecchi." />
                    <TextBlock Style="{StaticResource Caption}" Text="• Il controller Xbox virtuale viene aggiornato solo quando qualcosa cambia." />
                    <TextBlock x:Name="ConnectionTip" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource BrandBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Controller power -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Controller" />
            <ui:CardControl Icon="{ui:SymbolIcon Power24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontSize="14" Text="Spegni il controller quando chiudi DualPad" />
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="Vale per il Bluetooth. Via USB il controller resta alimentato dal cavo, quindi non si può spegnere." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="PowerOffOnExit" Click="OnPowerOffOnExit" />
            </ui:CardControl>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <ui:Button x:Name="PowerOffNow" Icon="{ui:SymbolIcon Power24}" Content="Spegni il controller ora" Click="OnPowerOffNow" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
