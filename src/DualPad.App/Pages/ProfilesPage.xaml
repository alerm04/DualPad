<UserControl x:Class="DualPad.App.Pages.ProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DualPad.App.Services"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,4,28,28">
            <TextBlock Style="{StaticResource PageTitle}" Text="{l:T nav.profiles}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="{l:T profiles.subtitle}" />

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="{l:T profiles.new}" Click="OnNew" />
                <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon ArrowImport24}" Content="{l:T profiles.import}" Click="OnImport" />
                <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon OpenFolder24}" Content="{l:T profiles.openFolder}" Click="OnOpenFolder" />
            </StackPanel>

            <StackPanel x:Name="List" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
