<UserControl x:Class="DualPad.App.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DualPad.App.Services"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:DualPad.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,4,28,28">
            <TextBlock Style="{StaticResource PageTitle}" Text="{l:T home.title}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="{l:T home.subtitle}" />

            <ui:InfoBar x:Name="ViGEmBar" Margin="0,16,0,0" IsOpen="False" IsClosable="False" Severity="Error"
                        Title="{l:T home.vigem.title}"
                        Message="{l:T home.vigem.message}" />
            <ui:InfoBar x:Name="BlockedBar" Margin="0,16,0,0" IsOpen="False" IsClosable="False" Severity="Warning"
                        Title="{l:T home.blocked.title}"
                        Message="{l:T home.blocked.message}" />
            <StackPanel x:Name="BlockedActions" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                <ui:Button Appearance="Primary" Content="{l:T home.closeDs4}" Click="OnCloseDs4Windows" />
            </StackPanel>
            <StackPanel x:Name="ViGEmActions" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                <ui:HyperlinkButton Content="{l:T home.downloadVigem}" NavigateUri="https://github.com/nefarius/ViGEmBus/releases/latest" />
            </StackPanel>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Panel}" Padding="24" MinHeight="420">
                    <Grid>
                        <c:ControllerView x:Name="Controller" MaxHeight="440" />
                        <Border x:Name="EmptyState" Background="Transparent">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                                <ui:SymbolIcon Symbol="XboxController24" FontSize="48" HorizontalAlignment="Center" Foreground="{StaticResource BrandBrush}" />
                                <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="{l:T home.empty.title}" />
                                <TextBlock Margin="0,10,0,0" TextAlignment="Center" Style="{StaticResource PageSubtitle}"
                                           Text="{l:T home.empty.text}" />
                                <TextBlock Margin="0,14,0,0" TextAlignment="Center" Style="{StaticResource Caption}"
                                           Text="{l:T home.empty.pairing}" />
                                <ui:Button Margin="0,16,0,0" HorizontalAlignment="Center" Content="{l:T home.empty.openBluetooth}" Icon="{ui:SymbolIcon Bluetooth24}" Click="OnOpenBluetooth" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                    <Border Style="{StaticResource Panel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon x:Name="ConnectionIcon" Symbol="PlugDisconnected24" FontSize="26" Foreground="{StaticResource BrandBrush}" />
                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <TextBlock Style="{StaticResource Caption}" Text="{l:T home.connection}" />
                                <TextBlock x:Name="ConnectionText" FontSize="16" FontWeight="SemiBold" Text="{l:T home.notConnected}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon x:Name="BatteryIcon" Symbol="Battery524" FontSize="26" Foreground="{StaticResource BrandBrush}" />
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Style="{StaticResource Caption}" Text="{l:T home.battery}" />
                                    <TextBlock x:Name="BatteryText" FontSize="16" FontWeight="SemiBold" Text="—" />
                                </StackPanel>
                            </Grid>
                            <ProgressBar x:Name="BatteryBar" Margin="0,12,0,0" Height="6" Maximum="100" Value="0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Games24" FontSize="26" Foreground="{StaticResource BrandBrush}" />
                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <TextBlock Style="{StaticResource Caption}" Text="{l:T home.xbox}" />
                                <TextBlock x:Name="XboxText" FontSize="16" FontWeight="SemiBold" Text="—" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="{l:T home.activeProfile}" />
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding ActiveProfile.Name}" />
                            <ui:Button Margin="0,12,0,0" HorizontalAlignment="Stretch" Appearance="Primary"
                                       Icon="{ui:SymbolIcon Edit24}" Content="{l:T home.customize}" Click="OnEditMapping" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Panel}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{l:T home.tip.title}" />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}"
                                       Text="{l:T home.tip.text}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
