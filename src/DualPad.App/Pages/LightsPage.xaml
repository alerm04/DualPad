<UserControl x:Class="DualPad.App.Pages.LightsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:DualPad.App.Services"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,4,28,28">
            <TextBlock Style="{StaticResource PageTitle}" Text="{l:T nav.lights}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T lights.subtitle}" />

            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T lights.lightbar}" />
            <Border Style="{StaticResource Panel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="{l:T lights.quick}" />
                        <WrapPanel x:Name="Swatches" Margin="0,8,0,0" />

                        <TextBlock Margin="0,14,0,0" Style="{StaticResource Caption}" Text="{l:T lights.custom}" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
                            </Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Foreground="#FF5A5A" FontWeight="Bold" Text="R" />
                            <Slider x:Name="SliderR" Grid.Column="1" VerticalAlignment="Center" Maximum="255" ValueChanged="OnRgbChanged" />
                            <TextBlock x:Name="ValueR" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" />
                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Foreground="#4ADE80" FontWeight="Bold" Text="G" />
                            <Slider x:Name="SliderG" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Maximum="255" ValueChanged="OnRgbChanged" />
                            <TextBlock x:Name="ValueG" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" />
                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Foreground="#60A5FA" FontWeight="Bold" Text="B" />
                            <Slider x:Name="SliderB" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Maximum="255" ValueChanged="OnRgbChanged" />
                            <TextBlock x:Name="ValueB" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" />
                        </Grid>

                        <TextBlock Margin="0,14,0,6" Style="{StaticResource Caption}" Text="{l:T lights.brightness}" />
                        <Border HorizontalAlignment="Left" Padding="3" CornerRadius="9" Background="{DynamicResource ControlAltFillColorSecondaryBrush}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="BrightHigh" Style="{StaticResource SegmentTab}" GroupName="Bright" Content="{l:T lights.high}" Width="80" Click="OnBrightness" />
                                <RadioButton x:Name="BrightMid" Style="{StaticResource SegmentTab}" GroupName="Bright" Content="{l:T lights.medium}" Width="80" Click="OnBrightness" />
                                <RadioButton x:Name="BrightLow" Style="{StaticResource SegmentTab}" GroupName="Bright" Content="{l:T lights.low}" Width="80" Click="OnBrightness" />
                            </StackPanel>
                        </Border>

                        <ui:ToggleSwitch x:Name="ShowBattery" Margin="0,16,0,0" Content="{l:T lights.battery}" Click="OnToggle" />
                        <ui:ToggleSwitch x:Name="PlayerLeds" Margin="0,10,0,0" Content="{l:T lights.playerLeds}" Click="OnToggle" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="24,0,0,0" HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" Text="{l:T common.preview}" />
                        <Border Margin="0,10,0,0" Width="180" Height="110" CornerRadius="16" Background="#14161B">
                            <Grid>
                                <Border x:Name="PreviewGlow" Width="140" Height="8" CornerRadius="4" VerticalAlignment="Top" Margin="0,18,0,0" Background="#0078FF">
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="PreviewShadow" BlurRadius="28" ShadowDepth="0" Color="#0078FF" Opacity="1" />
                                    </Border.Effect>
                                </Border>
                                <TextBlock x:Name="HexText" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16"
                                           Foreground="#C9CED6" FontFamily="Consolas" FontSize="14" Text="#0078FF" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T lights.rumble}" />
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <ui:ToggleSwitch x:Name="RumbleOn" Content="{l:T lights.rumbleOn}" Click="OnToggle" />
                    <TextBlock Margin="0,14,0,4" Text="{l:T lights.strength}" />
                    <DockPanel>
                        <TextBlock x:Name="StrengthValue" DockPanel.Dock="Right" Width="48" TextAlignment="Right" VerticalAlignment="Center" />
                        <Slider x:Name="Strength" Minimum="0" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnStrength" />
                    </DockPanel>
                    <ui:Button Margin="0,14,0,0" Icon="{ui:SymbolIcon PhoneVibrate24}" Content="{l:T lights.test}" Click="OnTestRumble" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
