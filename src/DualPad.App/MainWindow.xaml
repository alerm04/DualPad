<ui:FluentWindow x:Class="DualPad.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
                 Title="DualPad"
                 Width="1220" Height="800" MinWidth="980" MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Icon="pack://application:,,,/Assets/dualpad.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="DualPad" ShowMaximize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/dualpad.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <DockPanel Grid.Column="0" Margin="12,4,8,14" LastChildFill="False">
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavHome" Style="{StaticResource NavButton}" Tag="home" Checked="OnNav" IsChecked="True">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Home24" FontSize="20" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Home" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavMapping" Style="{StaticResource NavButton}" Tag="mapping" Checked="OnNav">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="XboxController24" FontSize="20" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Tasti" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" Tag="sticks" Checked="OnNav">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CursorClick24" FontSize="20" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Touchpad e stick" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" Tag="lights" Checked="OnNav">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Lightbulb24" FontSize="20" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Luci e vibrazione" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" Tag="profiles" Checked="OnNav">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="PersonAccounts24" FontSize="20" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Profili" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <!-- Mini controller status -->
                    <Border Style="{StaticResource Panel}" Padding="12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#6B7280" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock x:Name="StatusTitle" FontWeight="SemiBold" Text="Nessun controller" />
                                <TextBlock x:Name="StatusDetail" Style="{StaticResource Caption}" Text="In attesa del DualSense…" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <RadioButton Style="{StaticResource NavButton}" Tag="settings" Checked="OnNav">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="20" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Impostazioni" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>

            <!-- Content -->
            <Border Grid.Column="1" Margin="0,0,0,0" CornerRadius="12,0,0,0"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar shared by every page -->
                    <Grid Margin="28,16,28,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" Style="{StaticResource Caption}" FontSize="13" Text="Profilo" />
                            <ComboBox x:Name="ProfileBox" MinWidth="190" DisplayMemberPath="Name"
                                      ItemsSource="{Binding Profiles}" SelectedItem="{Binding ActiveProfile, Mode=TwoWay}" />
                            <Border Width="1" Margin="16,6" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                            <ui:ToggleSwitch VerticalAlignment="Center" IsChecked="{Binding MappingEnabled, Mode=TwoWay}"
                                             OnContent="Mappatura attiva" OffContent="Mappatura in pausa" />
                        </StackPanel>
                    </Grid>

                    <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False" />
                    <ui:SnackbarPresenter x:Name="Snackbars" Grid.Row="1" VerticalAlignment="Bottom" />
                </Grid>
            </Border>
        </Grid>

        <tray:NotifyIcon x:Name="Tray" Grid.Row="0" TooltipText="DualPad" FocusOnLeftClick="True" MenuOnRightClick="True"
                         Icon="pack://application:,,,/Assets/dualpad.png" LeftClick="OnTrayClick">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <MenuItem Header="Apri DualPad" Click="OnTrayOpen" />
                    <MenuItem x:Name="TrayMapping" Header="Mappatura attiva" IsCheckable="True"
                              IsChecked="{Binding MappingEnabled, Mode=TwoWay}" />
                    <Separator />
                    <MenuItem Header="Esci" Click="OnTrayExit" />
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>
    </Grid>
</ui:FluentWindow>
